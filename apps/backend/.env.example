# --- Database ---
DATABASE_URL="postgresql://dentalflow:dentalflow_dev_password@localhost:5433/dentalflow?schema=public"

# --- Redis / Queues ---
REDIS_URL="redis://localhost:6379"

# --- App ---
NODE_ENV=development
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# --- Auth ---
JWT_ACCESS_SECRET="replace-with-strong-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-strong-secret"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_PATIENT_ACCESS_SECRET="replace-with-strong-secret"
JWT_PATIENT_ACCESS_EXPIRES_IN="30d"

# --- Asistente DentalFlow AI (Claude API) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"

# --- WhatsApp Cloud API ---
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="dentalflow-verify-token"
WHATSAPP_APP_SECRET=""
WHATSAPP_API_VERSION="v21.0"

# --- OAuth (inicio de sesión con Google) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"

# --- Storage (S3-compatible) ---
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
